# =============================================================================
# Configuración local — NO subas el archivo .env a Git.
# Cada desarrollador: copia este archivo a ".env" en esta misma carpeta (raíz
# del proyecto GPCONES) y ajusta valores según su máquina / credenciales.
#
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
# =============================================================================

# Servidor API (el frontend en desarrollo usa proxy a este puerto)
PORT=3002
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=GP_CONES
DB_USER=postgres
DB_PASSWORD=cambia_esto

# JWT — usa un valor largo y aleatorio en equipo compartido (no el de ejemplo)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Archivos XTF y GDB
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Seguridad
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# GPCONES
XTF_VALIDATION_TIMEOUT=300000
GDB_READ_ONLY_ACCESS=true
AUDIT_LOG_ENABLED=true

# Email (recuperación de contraseña) — opcional en desarrollo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASS=contraseña_de_aplicacion_o_dejar_vacio
FRONTEND_URL=http://localhost:3000

PASSWORD_RESET_EXPIRY_MINUTES=30
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# Frontend (solo necesario en build/producción; en dev suele bastar el proxy)
# REACT_APP_API_URL=http://localhost:3002
